try height="16" width="1164" x="54" y="2" as="geometry"/></mxCell><UserObject label="alt" mermaidId="n:f1" mermaidBaseStyle="html=1;shape=umlFrame;strokeWidth=1;pointerEvents=0;dropTarget=0;fillColor=none;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#000000;height=20;width=50;" mermaidBaseValue="alt" id="oSy4BkIkn8blRTtzt744-482"><mxCell parent="oSy4BkIkn8blRTtzt744-472" style="html=1;shape=umlFrame;strokeWidth=1;pointerEvents=0;dropTarget=0;fillColor=none;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#000000;height=20;width=50;" vertex="1"><mxGeometry height="391" width="1372" x="190" y="573" as="geometry"/></mxCell></UserObject><mxCell id="oSy4BkIkn8blRTtzt744-483" parent="oSy4BkIkn8blRTtzt744-482" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" value="[Save Draft]" vertex="1"><mxGeometry height="16" width="1318" x="54" y="2" as="geometry"/></mxCell><mxCell id="oSy4BkIkn8blRTtzt744-484" parent="oSy4BkIkn8blRTtzt744-482" style="shape=line;dashed=1;fixDash=1;dashPattern=2 2;strokeColor=#000000;strokeWidth=1;" vertex="1"><mxGeometry height="1" width="1372" y="229" as="geometry"/></mxCell><mxCell id="oSy4BkIkn8blRTtzt744-485" parent="oSy4BkIkn8blRTtzt744-482" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" value="[Submit for Approval]" vertex="1"><mxGeometry height="16" width="1372" y="231" as="geometry"/></mxCell><UserObject label="alt" mermaidId="n:f2" mermaidBaseStyle="html=1;shape=umlFrame;strokeWidth=1;pointerEvents=0;dropTarget=0;fillColor=none;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#000000;height=20;width=50;" mermaidBaseValue="alt" id="oSy4BkIkn8blRTtzt744-486"><mxCell parent="oSy4BkIkn8blRTtzt744-472" style