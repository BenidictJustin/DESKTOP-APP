<mxfile host="Electron" modified="2026-07-26T06:29:09.123Z" agent="5.0" version="20.0.0" type="device">
  <diagram id="diag_uvktd2na0" name="3.2 Scenario B: Donation Log and FIFO Batch-Level Inventory Update">
    <mxGraphModel dx="764" dy="484" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin as Admin / Office Coordinator\n    participant UI as React Frontend (AdminDashboard / db.js)\n    participant FS as Cloud Firestore (donors, donations, inventory)\n\n    Admin-&gt;&gt;UI: Select/Create Donor &amp; Enter Donation Details (Date, Purpose, Items)\n    UI-&gt;&gt;UI: Validate donation metadata, item quantities, and units\n    \n    alt New Donor Selected\n        UI-&gt;&gt;FS: addDonor(donorData) -&gt; Write to donors collection\n        FS--&gt;&gt;UI: Return Donor Document ID\n    end\n\n    Admin-&gt;&gt;UI: Click \&quot;Save Donation\&quot;\n    UI-&gt;&gt;FS: addDonation(donationData) -&gt; Write to donations collection (donorId, date, purpose, items array)\n    FS--&gt;&gt;UI: Return Donation Document ID\n\n    loop For each item in donation batch (items array)\n        UI-&gt;&gt;FS: Query inventory collection where name == item.name\n        FS--&gt;&gt;UI: Return matching inventory documents\n\n        alt Exact Batch Match Exists (Same Name &amp; Same Expiration Date)\n            UI-&gt;&gt;UI: Calculate new quantity (existing.quantity + item.quantity)\n            UI-&gt;&gt;UI: computeInventoryStatus(newQty, expiryDate)\n            UI-&gt;&gt;FS: updateDoc(inventory/{itemId}, quantity, status, lastUpdatedBy, updatedAt)\n            FS--&gt;&gt;UI: Acknowledge Batch Quantity Update\n        else New Item OR Different Expiration Date\n            UI-&gt;&gt;UI: computeInventoryStatus(item.quantity, expiryDate)\n            UI-&gt;&gt;FS: addDoc(inventory) -&gt; Create new batch document (name, qty, expiryDate, receivedDate, donationId, status)\n            FS--&gt;&gt;UI: Return New Inventory Document ID\n        end\n    end\n\n    UI-&gt;&gt;FS: getInventory() -&gt; Fetch all inventory documents\n    FS--&gt;&gt;UI: Return raw inventory items array\n    UI-&gt;&gt;UI: Execute sortInventory() algorithm (Consumables: Nearest Expiration First | Non-Consumables: FIFO Oldest Received First)\n    UI-&gt;&gt;UI: Flag items for release recommendation &amp; 30-day expiring-soon alerts\n    UI--&gt;&gt;Admin: Display success toast &amp; update inventory tables with FIFO sequence&quot;,&#10;  &quot;config&quot;: null&#10;}" id="V_rv9zY1jVwXhqspQIYn-519"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry"/></mxCell></UserObject><UserObject label="Admin / Office Coordinator" mermaidId="n:Admin" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Admin / Office Coordinator" id="V_rv9zY1jVwXhqspQIYn-520"><mxCell parent="V_rv9zY1jVwXhqspQIYn-519" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1915" width="150" x="110" y="100" as="geometry"/></mxCell></UserObject><UserObject label="React Frontend (AdminDashboard / db.js)" mermaidId="n:UI" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);size=65;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="React Frontend (AdminDashboard / db.js)" id="V_rv9zY1jVwXhqspQIYn-521"><mxCell parent="V_rv9zY1jVwXhqspQIYn-519" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);size=65;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1890" width="150" x="656" y="100" as="geometry"/></mxCell></UserObject><UserObject label="Cloud Firestore (donors, donations, inventory)" mermaidId="n:FS" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);size=65;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Cloud Firestore (donors, donations, inventory)" id="V_rv9zY1jVwXhqspQIYn-522"><mxCell parent="V_rv9zY1jVwXhqspQIYn-519" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);size=65;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1890" width="150" x="1487" y="100" as="geometry"/></mxCell></UserObject><UserObject label="alt" mermaidId="n:f0" mermaidBaseStyle="html=1;shape=umlFrame;dashed=1;fixDash=1;dashPattern=2 2;strokeWidth=2;pointerEvents=0;dropTarget=0;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontSize=16;align=center;verticalAlign=middle;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-